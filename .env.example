# Copy to .env and fill in. .env is git-ignored; never commit a real API key.

# Required: base URL of your Jellyfin server (no trailing slash).
JELLYFIN_URL=http://jellyfin:8096

# Required: admin API key from Jellyfin Dashboard -> API Keys.
JELLYFIN_API_KEY=

# Optional: address and port the dashboard listens on.
LISTEN_ADDR=:8080

# Optional: minimum minutes between data refreshes.
REFRESH_MINUTES=30

# Optional: show Season 0 (Specials).
INCLUDE_SPECIALS=false

# Optional: require this password to view the dashboard. Leave empty for no password.
DASHBOARD_PASSWORD=

# Optional: timeout in seconds for each request to Jellyfin.
JELLYFIN_TIMEOUT_SECONDS=10
