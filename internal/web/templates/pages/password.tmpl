{{/* password: the password screen, shown only when DASHBOARD_PASSWORD is
     set. No header, tabs or htmx: the mark and name, a heading, what
     the password is, then the form, centred. Takes a PasswordPage. */}}
{{define "password-page"}}<!doctype html>
<html lang="en">
<head>
{{template "document-head" .Title}}
</head>
<body>
<main class="password-page">
<div class="password-page__panel">
<p class="password-page__brand">{{template "brand-mark" "password-page__mark"}}<span class="password-page__name">Jellyfin-watched</span></p>
<h1 class="password-page__title">Enter the password</h1>
<p class="password-page__text">This dashboard is password protected. The password is set in the server configuration.</p>
{{template "password-form" .Form}}
</div>
</main>
</body>
</html>
{{end}}
