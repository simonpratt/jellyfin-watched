{{define "content"}}
<div class="page-head">
<div class="page-head__text">
<h1 class="page-head__title">Movies</h1>
{{if .Summary}}<p class="page-head__summary">{{.Summary}}</p>{{end}}
</div>
<div class="page-head__tools"></div>
</div>
{{if not .Loaded}}
<p class="page-message">The library hasn't loaded yet.</p>
{{else if not .Movies}}
<p class="page-message">No movies in the library.</p>
{{else}}
<div class="list-head" aria-hidden="true"><span class="list-head__title">Title</span></div>
<ul class="movie-list">
{{range .Movies}}{{template "movie-row" .}}{{end}}
</ul>
{{end}}
{{end}}
