{{define "content"}}
{{if .Loaded}}<div class="page-head">
<div class="page-head__text">
<h1 class="page-head__title">Movies</h1>
{{if .Summary}}<p class="page-head__summary">{{.Summary}}</p>{{end}}
</div>
<div class="page-head__tools"></div>
</div>
{{end}}
{{if .Notice}}{{template "notice" .Notice}}{{end}}
{{if .Empty}}{{template "empty-state" .Empty}}
{{else if .Movies}}
<div class="list-head" aria-hidden="true"><span class="list-head__title">Title</span><span class="list-head__size">Size</span><span class="list-head__completion">Completed by</span></div>
<ul class="movie-list">
{{range .Movies}}{{template "movie-row" .}}{{end}}
</ul>
{{end}}
{{end}}
