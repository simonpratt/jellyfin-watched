{{/* layout: the page shell. Takes a view model that embeds Page. */}}
{{define "layout"}}<!doctype html>
<html lang="en">
<head>
{{template "document-head" .Title}}
<script src="/static/htmx.min.js" defer></script>
</head>
<body>
{{/* #app reloads itself from the current URL (hx-get="") when the refresh
     control reports new data ("library-updated"), swapping in the header
     and content together. hx-disinherit keeps its attributes off the
     controls inside it. */}}
<div id="app" class="app" hx-get="" hx-trigger="library-updated from:body" hx-select="#app" hx-target="this" hx-swap="outerHTML" hx-disinherit="*">
{{template "app-header" .Page}}
<main class="page">
{{template "content" .}}
</main>
</div>
</body>
</html>
{{end}}

{{/* document-head: what every page's <head> has: the title, icon, fonts
     and stylesheets. Takes the page title. */}}
{{define "document-head"}}<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.}} · Spool</title>
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/static/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/css/tokens.css">
<link rel="stylesheet" href="/static/css/components.css">{{end}}

{{/* app-header: Spool mark and name, the Movies / TV shows tabs, and the
     refresh control on the right. Takes a Page. */}}
{{define "app-header"}}<header class="app-header">
<a class="app-header__brand" href="/movies">{{template "spool-mark" "app-header__mark"}}<span class="app-header__name">Spool</span></a>
<nav id="app-tabs" class="app-header__tabs" aria-label="Library">
{{template "app-tabs" .}}</nav>
<div class="app-header__actions">{{template "refresh-control" .Refresh}}</div>
</header>
{{end}}

{{/* app-tabs: the Movies / TV shows tab links. Takes a Page. Their URLs
     carry the sort and layout, so a search or sort swap sends them again
     (list-fragment). */}}
{{define "app-tabs"}}{{range .Tabs}}<a class="app-header__tab" href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}{{if .Count}} <span class="app-header__count">{{.Count}}</span>{{end}}</a>
{{end}}{{end}}

{{/* list-fragment: a list page's htmx response: its content, plus the tabs
     swapped out of band into the header so they follow the new view. */}}
{{define "list-fragment"}}<nav id="app-tabs" class="app-header__tabs" aria-label="Library" hx-swap-oob="true">
{{template "app-tabs" .Page}}</nav>
{{template "content" .}}{{end}}

{{/* spool-mark: the reel, drawn in currentColor. Takes its CSS class. The
     same shape as static/favicon.svg. */}}
{{define "spool-mark"}}<svg class="{{.}}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10.25"/><circle cx="12" cy="6.75" r="1.9"/><circle cx="16.99" cy="10.38" r="1.9"/><circle cx="15.09" cy="16.25" r="1.9"/><circle cx="8.91" cy="16.25" r="1.9"/><circle cx="7.01" cy="10.38" r="1.9"/></svg>{{end}}
