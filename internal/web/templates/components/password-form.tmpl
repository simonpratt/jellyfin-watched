{{/* password-form: the password screen's form, the only form that posts
     to the dashboard. A labelled password field, then the primary button.
     With an Error, the field is marked invalid and the error, after an info
     mark, sits between the field and the button. Neutral: no warning
     colour. What was typed is never put back. Takes a PasswordForm. */}}
{{define "password-form"}}<form class="password-form" method="post" action="{{.Action}}">
<input type="hidden" name="next" value="{{.Next}}">
<div class="password-form__field">
<label class="password-form__label" for="password">Password</label>
<input class="password-form__input" id="password" name="password" type="password" autocomplete="current-password" autofocus required
{{- if .Error}} aria-invalid="true" aria-describedby="password-error"{{end}}>
{{- if .Error}}
<p class="password-form__error" id="password-error">{{template "info-mark" "password-form__error-mark"}}<span>{{.Error}}</span></p>
{{- end}}
</div>
{{template "button" .Submit}}
</form>
{{end}}
