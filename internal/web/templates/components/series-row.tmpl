{{/* series-row: one series in the TV shows list. Takes a SeriesRow. Poster,
     title over year, season and episode counts and the disclosure, then the
     series total; its seasons, when shown, hang below on a rail. The
     disclosure swaps in this same component from /tv/series/{id}. --card is
     the poster grid's variant: the head stacked under a large poster; open
     (--open), it spans the grid's width with its seasons as cards beside
     it. */}}
{{define "series-row"}}<li class="series-row{{if .Card}} series-row--card{{if .Seasons}} series-row--open{{end}}{{end}}" id="{{.ID}}">
<div class="series-row__head">
{{template "poster" .Poster}}
<div class="series-row__main">
<h2 class="series-row__title">{{.Title}}</h2>
<div class="series-row__meta">{{if .Year}}<span class="series-row__year">{{.Year}}</span>{{end}}<span class="series-row__counts">{{.Counts}}</span>{{if .Toggle}}{{template "button" .Toggle}}{{end}}</div>
</div>
<div class="series-row__size">{{template "size" .Size}}</div>
</div>
{{- if .Seasons}}
<ul class="series-row__seasons" id="{{.SeasonsID}}">
{{range .Seasons}}{{template "season-row" .}}{{end}}</ul>
{{- end}}
</li>
{{end}}
