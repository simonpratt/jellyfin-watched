{{/* movie-row: one movie in the Movies list. Takes a MovieRow. --card is the
     poster grid's variant: the same markup and facts, stacked under a large
     poster (see components.css). */}}
{{define "movie-row"}}<li class="movie-row{{if .Card}} movie-row--card{{end}}">
{{template "poster" .Poster}}
<div class="movie-row__main">
<h2 class="movie-row__title">{{.Title}}</h2>
{{if or .Year .Added}}<p class="movie-row__meta">{{if .Year}}<span class="movie-row__year">{{.Year}}</span>{{end}}{{if .Added}}<span class="movie-row__added">{{.Added}}</span>{{end}}</p>{{end}}
</div>
<div class="movie-row__facts">
<div class="movie-row__size">{{template "size" .Size}}</div>
<div class="movie-row__completion">{{template "completion" .Completion}}</div>
</div>
</li>
{{end}}
